{
  "manifest_version": 3,
  "name": "Read Ahead",
  "version": "0.1.0",
  "homepage_url": "https://github.com/farwydi/read-ahead",
  "description": "Чтение страниц и выделенного текста вслух через домашний Qwen.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://10.44.0.19/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://10.44.0.19:8080"
  },
  "action": {
    "default_title": "Read Ahead — читать вслух",
    "default_icon": "icon.png"
  },
  "icons": {"128": "icon.png"},
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+R"},
      "description": "Открыть Read Ahead"
    }
  },
  "minimum_chrome_version": "131",
  "browser_specific_settings": {
    "gecko": {
      "id": "read-ahead@farwydi.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["websiteContent"]}
    }
  }
}
